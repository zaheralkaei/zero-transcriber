# COOP/COEP enable SharedArrayBuffer → multithreaded WASM inference.
# Model weights come from the Hugging Face CDN in CORS mode (ACAO: *), which stays
# valid under `require-corp` — no proxy or coi-serviceworker is needed here.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Hashed build output is immutable; HTML must revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/index.html
  Cache-Control: no-cache